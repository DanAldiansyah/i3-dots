# ==========================================================
# DUNST THEME: ASUKA LANGLEY
# ==========================================================

[global]
    ### View ###
    monitor = 0
    follow = mouse
    
    # Size
    width = 320
    height = 120
    origin = top-right
    offset = 4x42
    scale = 1
    notification_limit = 3
    gap_size = 6    

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    ### Layout ###
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2           
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Typography ###
    font = JetBrainsMono Nerd Font 10
    line_height = 4
    markup = full
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Mouse Click ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    ### Radius ###
    corner_radius = 4 

[experimental]
    per_monitor_dpi = false


[global]
    frame_color = "#e81400"
    format = "<span foreground='#e81400' font_desc='JetBrainsMono Nerd Font Bold 11'>%s</span>\n%b"

[urgency_low]
    background = "#252525"
    foreground = "#eaeaea"
    frame_color = "#323232"
    timeout = 2

[urgency_normal]
    background = "#252525"
    foreground = "#eaeaea"
    frame_color = "#e81400"
    timeout = 3

[urgency_critical]
    background = "#252525"
    foreground = "#eaeaea"
    frame_color = "#e81400"
    timeout = 0