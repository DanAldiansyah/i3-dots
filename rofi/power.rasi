/*******************************************************************************
 * Power Menu
 *******************************************************************************/

configuration {
    show-icons: false;
}

@import "./current-theme.rasi"
@import "./themes/fonts.rasi"

window {
    transparency:       "real";
    location:           center;
    width:              460px;
    border:             2px;
    border-radius:      4px;
    border-color:       @primary;
    background-color:   @background;
}

mainbox {
    children:       [ "inputbar", "message", "listview" ];
    padding:        8px;
    spacing:        8px;
    orientation:    vertical;
}

inputbar {
    enable:         true;
    spacing:        8px;
    children:       [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    enable:             true;
    expand:             false;
    border-radius:      4px;
    str:                "󰐥";
    padding:            8px 14px;
    background-color:   @primary;
    text-color:         @background;
}

prompt {
    padding:            8px;
    border-radius:      4px;
    background-color:   @background-alt;
    enabled:            true;
    text-color:         @foreground;
    vertical-align:     0.5;
}

message {
    enabled:                     true;
    padding:                     10px;
    border-radius:               4px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

listview {
    enabled:          true;
    columns:          4;
    lines:            1;
    cycle:            true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          8px;
}

element {
    enabled:          true;
    padding:          12px;
    border-radius:    4px;
    background-color: @background-alt;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @primary;
    text-color:       @background;
}

element-text {
    horizontal-align:   0.5;
    text-color:         inherit;
    font:               "JetBrainsMono Nerd Font 24";
}