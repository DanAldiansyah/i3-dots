@import "./config/colors.rasi"
@import "./config/fonts.rasi"

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        " ";
    display-window:             " ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       650px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               4px;
    border:                      2px solid;
    border-color:                @lavender;
    cursor:                      "default";
    background-color:            @base;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     10px;
    padding:                     15px;
    orientation:                 vertical;
    children:                    [ "message", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     40px 40px;
    border-radius:               4px;
    background-color:            @surface-0;
    text-color:                  @text;
    orientation:                 horizontal;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " ";
    padding:                     8px 12px;
    border-radius:               4px;
    background-color:            @base;
    text-color:                  @lavender;
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    expand:                      true;
    padding:                     8px 12px;
    border-radius:               4px;
    background-color:            @base;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @lavender; /* Overlay0 */
    vertical-align:              0.5;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     2;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     5px;
    text-color:                  @text;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 12px;
    border-radius:               8px;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @text;
}

element selected.normal {
    background-color:            @lavender;
    text-color:                  @base;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @text;
}

element-icon {
    size:                        24px;
    cursor:                      inherit;
}

element-text {
    vertical-align:              0.5;
    text-color:                  inherit;
}

/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    text-color:                  @text;
}

button {
    padding:                     8px;
    border-radius:               8px;
    background-color:            @surface-0;
    text-color:                  inherit;
    cursor:                      pointer;
}

button selected {
    background-color:            @lavender;
    text-color:                  @base;
}

/*****----- Message -----*****/
error-message {
    padding:                     15px;
    border-radius:               12px;
    background-color:            @base;
    text-color:                  @red;
}
